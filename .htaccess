# ─────────────────────────────────────────────────────────────
#  Сальса Плюс — настройки сервера (Apache, TimeWeb)
# ─────────────────────────────────────────────────────────────
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Страница «не найдено» с правильным кодом ответа 404
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. www → без www (рабочий домен), сразу на https
RewriteCond %{HTTP_HOST} ^www\.salsaplus\.ru$ [NC]
RewriteRule ^(.*)$ https://salsaplus.ru/$1 [R=301,L]

# 2. http → https (рабочий домен). На TimeWeb признак https — заголовок X-HTTPS
RewriteCond %{HTTP_HOST} ^salsaplus\.ru$ [NC]
RewriteCond %{HTTP:X-HTTPS} !1
RewriteRule ^(.*)$ https://salsaplus.ru/$1 [R=301,L]

# Протокол для остальных редиректов: на salsaplus.ru и при https — сразу https (без цепочек)
RewriteRule ^ - [E=PROTO:http]
RewriteCond %{HTTP:X-HTTPS} 1 [OR]
RewriteCond %{HTTP_HOST} ^salsaplus\.ru$ [NC]
RewriteRule ^ - [E=PROTO:https]

# 3. /index.html, /index.php и …/index.html → адрес папки (главная — «/»)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.(?:html?|php)[\s?] [NC]
RewriteRule ^ %{ENV:PROTO}://%{HTTP_HOST}/%1 [R=301,L,NE]

# 4. Старые адреса прежнего сайта → живые страницы
RewriteRule ^publichnaya-oferta/publichnaya-oferta\.php$ %{ENV:PROTO}://%{HTTP_HOST}/publichnaya-oferta/publichnaya-oferta.html [R=301,L]
RewriteRule ^prepodavateli-shkoly-salsa-plyus/([^/]+)/?$ %{ENV:PROTO}://%{HTTP_HOST}/prepodavateli/$1/ [R=301,L]
RewriteRule ^prepodavateli-shkoly-salsa-plyus/?$ %{ENV:PROTO}://%{HTTP_HOST}/prepodavateli/ [R=301,L]
RewriteRule ^raspisanie-i-ceny/?$ %{ENV:PROTO}://%{HTTP_HOST}/raspisanie/ [R=301,L]
RewriteRule ^uslugi-salsa-plyus/salsa-vecherinki-v-spb/?$ %{ENV:PROTO}://%{HTTP_HOST}/vecherinki/ [R=301,L]
RewriteRule ^blog/item/ %{ENV:PROTO}://%{HTTP_HOST}/blog/ [R=301,L]
RewriteRule ^stili-tancev/tanets-kizomba-uroki-kizomby-v-spb/?$ %{ENV:PROTO}://%{HTTP_HOST}/stili-tancev/kizomba/ [R=301,L]
RewriteRule ^stili-tancev/tanets-salsa-kasino-kubinskaya-kubana/?$ %{ENV:PROTO}://%{HTTP_HOST}/stili-tancev/salsa-casino/ [R=301,L]

# 5. Страницы педагогов, которых больше нет на сайте → список педагогов
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^prepodavateli/[^/]+/?$ %{ENV:PROTO}://%{HTTP_HOST}/prepodavateli/ [R=301,L]

# 6. Адрес папки без «/» в конце → с «/» (один адрес на страницу)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ %{ENV:PROTO}://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
# ▼ ТЕСТОВАЯ ВЕРСИЯ: закрыто от поисковиков. ПЕРЕД ЗАПУСКОМ на salsaplus.ru удалить строку ниже.
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
